//CBLAA00  JOB NOTIFY=&SYSUID
//*==================================================================
//* AA00 - ECRANS + MODULES RPC DB2 (schema DEMOUSR)
//* 30 PROGRAMMES x 6 STEPS (CBCICSD2) = 180 STEPS
//*
//* LOT 3 DE 3 - REMPLACE L'ANCIEN CBLREST (66 PGM = 396 STEPS,
//* AU-DELA DE LA LIMITE DE 255 STEPS PAR JOB).
//* SOUMETTRE DANS L'ORDRE : CBLAL00, PUIS CBLAD00, PUIS CBLAA00.
//*
//* RC=8 ATTENDU SUR REBINDPL AU PREMIER PROGRAMME TANT QUE LE PLAN
//* DEMOUSR N'EXISTE PAS - C'EST CE RC QUI DECLENCHE BINDPLAN, QUI
//* LE CREE. VOIR COND=(4,GT,REBINDPL) DANS LA PROC.
//*
//* CE QUI COMPTE : COBOL <= 04 ET LKED = 00 SUR CHAQUE PROGRAMME.
//*==================================================================
//MYLIB    JCLLIB ORDER=(OLS0009.PROCS.JCL)
//  EXPORT SYMLIST=*
//*
//COSGN00U EXEC PROC=CBCICSD2,
//  GOPGM=COSGN00U,

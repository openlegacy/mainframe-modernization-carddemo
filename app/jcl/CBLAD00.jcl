//CBLAD00  JOB NOTIFY=&SYSUID
//*==================================================================
//* AD00 - ECRANS DB2 (SQL statique, schema DEMOUSR)
//* 15 PROGRAMMES x 6 STEPS (CBCICSD2) = 90 STEPS
//*
//* LOT 2 DE 3 - REMPLACE L'ANCIEN CBLREST (66 PGM = 396 STEPS,
//* AU-DELA DE LA LIMITE DE 255 STEPS PAR JOB).
//* SOUMETTRE DANS L'ORDRE : CBLAL00, PUIS CBLAD00, PUIS CBLAA00.
//*
//* RC=8 ATTENDU SUR REBINDPL AU PREMIER PROGRAMME TANT QUE LE PLAN
//* DEMOUSR N'EXISTE PAS - C'EST CE RC QUI DECLENCHE BINDPLAN, QUI
//* LE CREE. VOIR COND=(4,GT,REBINDPL) DANS LA PROC.
//*
//* CE QUI COMPTE : COBOL <= 04 ET LKED = 00 SUR CHAQUE PROGRAMME.
//*==================================================================
//MYLIB    JCLLIB ORDER=(OLS0009.PROCS.JCL)
//  EXPORT SYMLIST=*
//*
//COSGN00D EXEC PROC=CBCICSD2,
//  GOPGM=COSGN00D,
//  DBRMLIB=DEMOUSR.CARDDEMO.DBRM,
//  QUALIF=DEMOUSR,
//  PGMLIB=DEMOUSR.CICS.PGMLIB
//COBOL.SYSLIB DD DSN=DEMOUSR.CARDDEMO.CPY,DISP=SHR
//             DD DSN=DEMOUSR.CARDDEMO.BMS.CPY,DISP=SHR
//             DD DSN=DFH610.CICS.ADFHCOB,DISP=SHR
//             DD DSN=DFH610.CICS.ADFHMAC,DISP=SHR
//COBOL.SYSLIN DD DSN=&&LOADSET,DISP=(MOD,PASS),UNIT=SYSDA,
//         SPACE=(TRK,(1,1))
//COBOL.SYSIN  DD DSN=DEMOUSR.CARDDEMO.CBL(&GOPGM),DISP=SHR
//LKED.SYSLIB  DD DSN=CEE.SCEELKED,DISP=SHR
//             DD DSN=DEMOUSR.CICS.PGMLIB,DISP=SHR
//LKED.SYSLIN  DD DSN=&&LOADSET,DISP=(OLD,DELETE)

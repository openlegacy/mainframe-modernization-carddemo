//*******************************************************************
//****  CARDDEMO - CICS RESOURCE DEFINITIONS - GROUP(DEMOUSR)  *****
//*******************************************************************
//*
//*  DEFINES EVERY CICS RESOURCE OF THE FOUR DEMO PATTERNS:
//*
//*    CC00 - ORIGINAL DEMO       SCREEN -> VSAM
//*    AL00 - SCREEN -> RPC       RPC SERVER READS VSAM
//*    AD00 - SCREEN -> DB2       EMBEDDED SQL IN THE SCREEN PGM
//*    AA00 - SCREEN -> RPC/DB2   RPC SERVER RUNS THE SQL
//*
//*  EVERY TRANSACTION ID BELOW IS THE VALUE CODED IN THE COBOL
//*  SOURCE ITSELF (WS-TRANID OR LIT-THISTRANID).  THE DB2TRAN
//*  RESOURCE NAMES ARE IDENTICAL TO THOSE TRANSACTION IDS, SO
//*  DB2TRAN(ADS4) DRIVES TRANSID(ADS4) WHICH RUNS COCRDLID.
//*
//*  ALL DB2 WORK RUNS THROUGH TWO DB2ENTRYS - AD00 AND AA00
//*  NAME - SEE THE &SCHEMA SYMBOL BELOW.
//*
//*  SEE pattern-component-catalog.md AT THE ROOT OF THE REPO FOR
//*  THE FULL PROGRAM / TRANSACTION / TABLE CROSS REFERENCE.
//*
//*  RERUN NOTE: UNCOMMENT THE "DELETE GROUP(DEMOUSR)" COMMAND
//*  BELOW WHEN YOU RELOAD THE GROUP FROM SCRATCH.
//*
//*  INSTALL WITH:  CEDA INSTALL GROUP(DEMOUSR)
//*
//*******************************************************************
//*  ---------------------------
//*  SET PARMS FOR THIS JOB:
//*  ---------------------------
//   SET HLQ=DEMOUSR.CARDDEMO
//*  DB2 SCHEMA / AUTHID - THE SINGLE SCHEMA USED BY EVERY DB2TRAN
//   SET SCHEMA=DEMOUSR
//*  DB2 PLAN THE CARDDEMO DBRMS ARE BOUND INTO
//   SET DB2PLAN=DEMOUSR
//*  CICSHLQ - HLQ OF THE CICS LIBRARIES (STEPLIB / SDFHLOAD) ONLY.
//*  THE CSD IS HARD CODED ON //DFHCSD BELOW - IT MUST BE THE ONE
//*  REGION CICSTS61 ALLOCATES (CEMT INQ FILE(DFHCSD) TO CHECK).
//   SET CICSHLQ=DFH610
//*
//*  NOTE ON THE SCHEMA:  AUTHID(&SCHEMA) SETS THE PRIMARY AUTH ID
//*  OF THE CICS DB2 THREAD.  THE STATIC SQL IN THESE PROGRAMS IS
//*  NOW HARD QUALIFIED AS &SCHEMA..TABLE IN THE COBOL SOURCE, SO
//*  THE BIND QUALIFIER NO LONGER SELECTS THE TARGET - BIND WITH
//*  QUALIFIER(&SCHEMA) ANYWAY TO KEEP THE TWO FROM DIVERGING.
//*
//STEP1   EXEC PGM=DFHCSDUP,REGION=0M,
//          PARM='CSD(READWRITE),PAGESIZE(60),NOCOMPAT'
//STEPLIB  DD  DSN=&CICSHLQ..CICS.SDFHLOAD,DISP=SHR
//*  ORIGINAL - DEFAULT CSD OF THE CICSHLQ (DFH610.DFHCSD) :
//*DFHCSD   DD  DISP=SHR,DSN=&CICSHLQ..DFHCSD
//*  CSD ACTUALLY READ BY REGION CICSTS61 :
//DFHCSD   DD  DISP=SHR,DSN=DFH610.CICSDEMO.DFHCSD
//OUTDD    DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *,SYMBOLS=JCLONLY
*/*******************************************************************/
*/*  DEMOUSR CICS DEFINITIONS                                      */
*/*******************************************************************/
*
* DELETE GROUP(DEMOUSR)
*
*/*******************************************************************/
*/*  LIBRARY                                                        */
*/*******************************************************************/
*/  DEFINE LIBRARY(DEMOULIB) GROUP(DEMOUSR)
*/         DESCRIPTION(CARDDEMO LOAD LIBRARY)
*/ /        RANKING(50) CRITICAL(NO) STATUS(ENABLED)
*       DSNAME01(&HLQ..LOADLIB)*
*/
*//*******************************************************************/
*/*  VSAM FILES                                                     */
*/*                                                                 */
*/*  THESE ARE THE SAME EIGHT FILES ALREADY DEFINED IN              */
*/*  GROUP(CARDDEMO).  THEY ARE REPEATED HERE SO DEMOUSR IS A      */
*/*  SELF CONTAINED GROUP - COMMENT THEM OUT IF YOU KEEP            */
*/*  INSTALLING GROUP(CARDDEMO) FOR THE DATA.                       */
*/*******************************************************************/
  DEFINE FILE(ACCTDAT) GROUP(DEMOUSR)
         DESCRIPTION(ACCOUNT MASTER)
         DSNAME(&HLQ..ACCTDATA.VSAM.KSDS)
         LSRPOOLNUM(1) STRINGS(1) STATUS(ENABLED)
         OPENTIME(FIRSTREF) DISPOSITION(SHARE) RECORDFORMAT(V)
         ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)

  DEFINE FILE(CARDDAT) GROUP(DEMOUSR)
         DESCRIPTION(CARD MASTER)
         DSNAME(&HLQ..CARDDATA.VSAM.KSDS)
         LSRPOOLNUM(1) STRINGS(1) STATUS(ENABLED)
         OPENTIME(FIRSTREF) DISPOSITION(SHARE) RECORDFORMAT(V)
         ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)

  DEFINE FILE(CARDAIX) GROUP(DEMOUSR)
         DESCRIPTION(CARD AIX BY ACCOUNT KEY)
         DSNAME(&HLQ..CARDDATA.VSAM.AIX.PATH)
         LSRPOOLNUM(1) STRINGS(1) STATUS(ENABLED)
         OPENTIME(FIRSTREF) DISPOSITION(SHARE) RECORDFORMAT(V)
         ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)

  DEFINE FILE(CCXREF) GROUP(DEMOUSR)
         DESCRIPTION(CARD TO ACCOUNT XREF)
         DSNAME(&HLQ..CARDXREF.VSAM.KSDS)
         LSRPOOLNUM(1) STRINGS(1) STATUS(ENABLED)
         OPENTIME(FIRSTREF) DISPOSITION(SHARE) RECORDFORMAT(V)
         ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)

  DEFINE FILE(CXACAIX) GROUP(DEMOUSR)
         DESCRIPTION(XREF AIX BY ACCOUNT KEY)
         DSNAME(&HLQ..CARDXREF.VSAM.AIX.PATH)
         LSRPOOLNUM(1) STRINGS(1) STATUS(ENABLED)
         OPENTIME(FIRSTREF) DISPOSITION(SHARE) RECORDFORMAT(V)
         ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)

  DEFINE FILE(CUSTDAT) GROUP(DEMOUSR)
         DESCRIPTION(CUSTOMER MASTER)
         DSNAME(&HLQ..CUSTDATA.VSAM.KSDS)
         LSRPOOLNUM(1) STRINGS(1) STATUS(ENABLED)
         OPENTIME(FIRSTREF) DISPOSITION(SHARE) RECORDFORMAT(V)
         ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)

  DEFINE FILE(TRANSACT) GROUP(DEMOUSR)
         DESCRIPTION(TRANSACTION MASTER)
         DSNAME(&HLQ..TRANSACT.VSAM.KSDS)
         LSRPOOLNUM(1) STRINGS(1) STATUS(ENABLED)
         OPENTIME(FIRSTREF) DISPOSITION(SHARE) RECORDFORMAT(V)
         ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)

  DEFINE FILE(USRSEC) GROUP(DEMOUSR)
         DESCRIPTION(USER SECURITY FILE)
         DSNAME(&HLQ..USRSEC.VSAM.KSDS)
         LSRPOOLNUM(1) STRINGS(1) STATUS(ENABLED)
         OPENTIME(FIRSTREF) DISPOSITION(SHARE) RECORDFORMAT(V)
         ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)

*/*******************************************************************/
*/*  TDQUEUE - USED BY CORPT00C TO SUBMIT THE REPORT JOB            */
*/*******************************************************************/
  DEFINE TDQUEUE(JOBS) GROUP(DEMOUSR)
         DESCRIPTION(SUBMIT JOBS FROM CICS)
         TYPE(EXTRA) DATABUFFERS(1) DDNAME(INREADER)
         ERROROPTION(IGNORE) OPENTIME(DEFERRED) TYPEFILE(OUTPUT)
         RECORDSIZE(80) RECORDFORMAT(FIXED)
         BLOCKFORMAT(UNBLOCKED) DISPOSITION(MOD)


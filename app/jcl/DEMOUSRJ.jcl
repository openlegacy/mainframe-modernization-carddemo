*/*******************************************************************/
*/*  DB2 CONNECTION                                                 */
*/*                                                                 */
*/*  ONLY ONE DB2CONN CAN BE INSTALLED IN A REGION.  UNCOMMENT      */
*/*  AND ADJUST DB2ID ONLY IF THIS REGION DOES NOT ALREADY HAVE     */
*/*  ONE - OTHERWISE INSTALLING IT REPLACES THE EXISTING            */
*/*  CONNECTION.                                                    */
*/*******************************************************************/
* DEFINE DB2CONN(DEMOUSR) GROUP(DEMOUSR)
*        DESCRIPTION(CARDDEMO DB2 CONNECTION)
*        DB2ID(DBC1) CONNECTERROR(SQLCODE) STANDBYMODE(RECONNECT)
*        SIGNID(&SCHEMA) STATSQUEUE(DFHSTAT)
*        TCBLIMIT(12) THREADLIMIT(3) THREADWAIT(YES)
*        ACCOUNTREC(NONE) DROLLBACK(YES) PRIORITY(HIGH)
*        AUTHID(&SCHEMA)

*/*******************************************************************/
*/*  DB2ENTRY - ONE ENTRY PER VARIANT                              */
*/*                                                                 */
*/*  AD00 - THE 15 AD00 DB2TRANS POINT AT ENTRY(AD00)              */
*/*  AA00 - THE 15 AA00 DB2TRANS POINT AT ENTRY(AA00)              */
*/*                                                                 */
*/*  BOTH ENTRIES CARRY THE SAME PLAN(&DB2PLAN) AND AUTHID(&SCHEMA) */
*/*  BIND THE PLAN WITH QUALIFIER(&SCHEMA) SO THE UNQUALIFIED TABLE */
*/*  NAMES IN THE STATIC SQL RESOLVE TO THE SAME SCHEMA.            */
*/*                                                                 */
*/*  NO TRANSID() IS CODED HERE ON PURPOSE - EVERY TRANSACTION IS   */
*/*  ATTACHED THROUGH ITS OWN DB2TRAN BELOW, SO THE DB2TRAN NAME    */
*/*  AND THE TRANSACTION ID ARE ALWAYS THE SAME STRING.  A          */
*/*  DB2ENTRY AND A DB2TRAN MAY SHARE A NAME (AD00 / AA00) - THEY   */
*/*  ARE DIFFERENT OBJECT TYPES, NO CONFLICT.                       */
*/*******************************************************************/
  DEFINE DB2ENTRY(AD00) GROUP(DEMOUSR)
         DESCRIPTION(CARDDEMO AD00 DB2 ENTRY SCHEMA &SCHEMA)
         PLAN(&DB2PLAN) AUTHID(&SCHEMA)
         ACCOUNTREC(NONE) DROLLBACK(YES) PRIORITY(HIGH)
         PROTECTNUM(0) THREADLIMIT(50) THREADWAIT(POOL)

  DEFINE DB2ENTRY(AA00) GROUP(DEMOUSR)
         DESCRIPTION(CARDDEMO AA00 DB2 ENTRY SCHEMA &SCHEMA)
         PLAN(&DB2PLAN) AUTHID(&SCHEMA)
         ACCOUNTREC(NONE) DROLLBACK(YES) PRIORITY(HIGH)
         PROTECTNUM(0) THREADLIMIT(50) THREADWAIT(POOL)

*/*******************************************************************/
*/*  DB2TRAN - PATTERN AD00                                         */
*/*  NAME = TRANSID = THE WS-TRANID / LIT-THISTRANID OF THE PROGRAM */
*/*******************************************************************/
  DEFINE DB2TRAN(AD00) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(AD00) DESCRIPTION(AD00 COSGN00D)
  DEFINE DB2TRAN(ADAM) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADAM) DESCRIPTION(AD00 COADM01D)
  DEFINE DB2TRAN(ADUM) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADUM) DESCRIPTION(AD00 COMEN01D)
  DEFINE DB2TRAN(ADS0) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADS0) DESCRIPTION(AD00 COUSR00D)
  DEFINE DB2TRAN(AD01) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(AD01) DESCRIPTION(AD00 COUSR01D)
  DEFINE DB2TRAN(ADS2) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADS2) DESCRIPTION(AD00 COUSR02D)
  DEFINE DB2TRAN(ADS3) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADS3) DESCRIPTION(AD00 COUSR03D)
  DEFINE DB2TRAN(ADS4) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADS4) DESCRIPTION(AD00 COCRDLID)
  DEFINE DB2TRAN(ADS5) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADS5) DESCRIPTION(AD00 COACTUPD)
  DEFINE DB2TRAN(ADS6) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADS6) DESCRIPTION(AD00 COCRDSLD)
  DEFINE DB2TRAN(ADS7) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADS7) DESCRIPTION(AD00 COCRDUPD)
  DEFINE DB2TRAN(ADS9) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADS9) DESCRIPTION(AD00 COACTVWD)
  DEFINE DB2TRAN(ADT1) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADT1) DESCRIPTION(AD00 COTRN2AD)
  DEFINE DB2TRAN(ADT2) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADT2) DESCRIPTION(AD00 COTRN2BD)
  DEFINE DB2TRAN(ADT3) GROUP(DEMOUSR) ENTRY(AD00)
         TRANSID(ADT3) DESCRIPTION(AD00 COTRN2CD)

*/*******************************************************************/
*/*  DB2TRAN - PATTERN AA00                                         */
*/*  THE *A RPC SERVERS RUN THE SQL BUT INHERIT THE TRANSACTION ID  */
*/*  OF THE *U SCREEN THAT LINKS TO THEM, SO ATTACHING THE AA??     */
*/*  TRANSACTIONS COVERS THE WHOLE PATTERN.                         */
*/*******************************************************************/
  DEFINE DB2TRAN(AA00) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AA00) DESCRIPTION(AA00 COSGN00U)
  DEFINE DB2TRAN(AAAM) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAAM) DESCRIPTION(AA00 COADM01U)
  DEFINE DB2TRAN(AAUM) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAUM) DESCRIPTION(AA00 COMEN01U)
  DEFINE DB2TRAN(AAS0) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS0) DESCRIPTION(AA00 COUSR00U COUSR00A)
  DEFINE DB2TRAN(AAS1) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS1) DESCRIPTION(AA00 COUSR01U COUSR01A)
  DEFINE DB2TRAN(AAS2) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS2) DESCRIPTION(AA00 COUSR02U COUSR02A)
  DEFINE DB2TRAN(AAS3) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS3) DESCRIPTION(AA00 COUSR03U COUSR03A)
  DEFINE DB2TRAN(AAS4) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS4) DESCRIPTION(AA00 COCRDLIU COCRDLIA)
  DEFINE DB2TRAN(AAS5) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS5) DESCRIPTION(AA00 COACTUPU COACTUPA)
  DEFINE DB2TRAN(AAS6) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS6) DESCRIPTION(AA00 COCRDSLU COCRDSLA)
  DEFINE DB2TRAN(AAS7) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS7) DESCRIPTION(AA00 COCRDUPU COCRDUPA)
  DEFINE DB2TRAN(AAS9) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AAS9) DESCRIPTION(AA00 COACTVWU COACTVWA)
  DEFINE DB2TRAN(AASA) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AASA) DESCRIPTION(AA00 COACCSTU COCUSTMA)
  DEFINE DB2TRAN(AASC) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AASC) DESCRIPTION(AA00 COACTADU COACTADA)
  DEFINE DB2TRAN(AASD) GROUP(DEMOUSR) ENTRY(AA00)
         TRANSID(AASD) DESCRIPTION(AA00 COCUSADU COCUSADA)

*/*******************************************************************/
*/*  ADD THE GROUP TO YOUR STARTUP LIST - SET THE LIST NAME FIRST   */
*/*******************************************************************/
  ADD GROUP(DEMOUSR) LIST(DEMOLIST)

  LIST GROUP(DEMOUSR)
*
* END DEMOUSR RESOURCES
*
